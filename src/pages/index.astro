---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games.flatMap((game) => game.categories.map((category) => [category.id, category])),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games.flatMap((game) => game.publisher ? [[game.publisher.id, game.publisher]] : []),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <section
            aria-label="Filter games"
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5"
            data-testid="game-filters"
          >
            <div class="flex flex-col gap-6 md:flex-row md:items-end">
              <fieldset class="min-w-0 flex-1">
                <legend class="mb-3 text-sm font-semibold text-slate-100">Categories</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="accent-blue-500"
                        data-testid={`category-filter-${category.id}`}
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex flex-col gap-2 md:w-64">
                <label for="publisher-filter" class="text-sm font-semibold text-slate-100">Publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
                </select>
              </div>

              <button
                type="button"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-game-filters"
              >
                Clear filters
              </button>
            </div>
          </section>

          <p class="mb-4 text-sm text-slate-300" role="status" aria-live="polite" data-testid="game-results-count">
            Showing {games.length} games
          </p>
          <p class="mb-4 hidden text-slate-300" data-testid="game-filter-empty-state">
            No games match these filters.
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-testid="game-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const resultsCount = document.querySelector<HTMLElement>('[data-testid="game-results-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="game-filter-empty-state"]');

  if (filters && gamesGrid && resultsCount && emptyState) {
    const activeGamesGrid = gamesGrid;
    const activeResultsCount = resultsCount;
    const activeEmptyState = emptyState;
    const categoryInputs = Array.from(
      filters.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherSelect = filters.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const clearButton = filters.querySelector<HTMLButtonElement>('[data-testid="clear-game-filters"]');
    const cards = Array.from(activeGamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    function updateGameFilters(): void {
      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => input.value);
      const publisherId = publisherSelect?.value ?? '';
      const matchingCards = cards.filter((card) => {
        const categoryIds = (card.dataset.categoryIds ?? '').split(',').filter(Boolean);
        const categoryMatches = selectedCategories.length === 0
          || selectedCategories.some((categoryId) => categoryIds.includes(categoryId));
        const publisherMatches = publisherId === ''
          || publisherId === (card.dataset.publisherId ?? '');
        return categoryMatches && publisherMatches;
      });

      matchingCards.sort((a, b) => {
        const aCategoryIds = (a.dataset.categoryIds ?? '').split(',').filter(Boolean);
        const bCategoryIds = (b.dataset.categoryIds ?? '').split(',').filter(Boolean);
        const aMatches = selectedCategories.filter((id) => aCategoryIds.includes(id)).length;
        const bMatches = selectedCategories.filter((id) => bCategoryIds.includes(id)).length;
        return bMatches - aMatches;
      });

      for (const card of cards) {
        card.hidden = !matchingCards.includes(card);
      }
      for (const card of matchingCards) {
        activeGamesGrid.append(card);
      }

      activeResultsCount.textContent = `Showing ${matchingCards.length} of ${cards.length} games`;
      activeEmptyState.classList.toggle('hidden', matchingCards.length !== 0);
    }

    for (const input of categoryInputs) {
      input.addEventListener('change', updateGameFilters);
    }
    publisherSelect?.addEventListener('change', updateGameFilters);
    clearButton?.addEventListener('click', () => {
      for (const input of categoryInputs) {
        input.checked = false;
      }
      if (publisherSelect) {
        publisherSelect.value = '';
      }
      updateGameFilters();
    });
  }
</script>
